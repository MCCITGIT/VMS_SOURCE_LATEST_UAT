    Private Function LPad(ByVal str As String, ByVal len As Integer) As String
        Return str.PadLeft(len, " ")
    End Function

    Private Function RPad(ByVal str As String, ByVal len As Integer) As String
        Return str.PadRight(len, " ")
    End Function

End Class

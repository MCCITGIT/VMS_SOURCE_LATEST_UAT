    End Sub
#End Region

#Region "Populate Site Details"
    Public Sub PopulateSiteDetails()
        CheckLogin()
        ddlSite.Items.Clear()
        Dim commonObj As New UnitDespatchClass
        Dim DepotDS As New DataSet

        DepotDS = commonObj.GetSiteDetailsList(ddlDeliveryDepot.SelectedValue, userInfo.userIDEntity)
        If (Not (DepotDS Is Nothing) AndAlso DepotDS.Tables.Count > 0 AndAlso Not (DepotDS.Tables(0) Is Nothing) AndAlso DepotDS.Tables(0).Rows.Count > 0) Then
            ddlSite.DataSource = DepotDS.Tables(0)
            ddlSite.DataTextField = "us_site_name"
            ddlSite.DataValueField = "us_site_name"

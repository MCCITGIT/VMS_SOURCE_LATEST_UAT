Imports VMS.Web
Imports System.Data
Imports System.Data.SqlTypes
Partial Class Form_Menu
    Inherits System.Web.UI.Page

#Region "Page Load Event Handler"
    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load
        If (Not IsPostBack) Then

            populateFormType()
            PageSizeDropdown()
            RetrieveSearchCriteria()
            SaveSearchCriteria()
            FormTypeLoad()
            'FormMenuListLoad()

        End If
    End Sub
#End Region

#Region "Save Search Criteria"
    ' Saves the current search criteria in session
    Private Sub SaveSearchCriteria()
        Dim FormMenuSearchInfo As New FormMenuSearchCriteria
        FormMenuSearchInfo.FormType = ddlFormType.SelectedValue
        FormMenuSearchInfo.PageIndex = gvFormMenu.PageIndex
        Session(Constant.SessionKeys.FormMenuSearchInfo) = FormMenuSearchInfo


    End Sub
#End Region

#Region "Retrieve Search Criteria"
    ' Retrieve the existing search criteria in session
    Private Sub RetrieveSearchCriteria()
        If (Not (Session(Constant.SessionKeys.FormMenuSearchInfo) Is Nothing)) Then
            Dim FormMenuSearchInfo As New FormMenuSearchCriteria
            FormMenuSearchInfo = Session(Constant.SessionKeys.FormMenuSearchInfo)
            ddlFormType.SelectedValue = FormMenuSearchInfo.FormType
            gvFormMenu.PageIndex = FormMenuSearchInfo.PageIndex

        End If

    End Sub
#End Region


#Region "Populate FormType"
    Public Sub populateFormType()

        Dim userInfo As VMSUserEntity = New VMSUserEntity()
        If (Not (Session(Constant.SessionKeys.UserInfo) Is Nothing)) Then
            userInfo = CType(Session(Constant.SessionKeys.UserInfo), VMSUserEntity)
        Else
            Response.Redirect("~/Login.aspx")
        End If

        Dim ObjDocumentType As New FormMenu
        Dim StatusTypeSet As New DataSet
        StatusTypeSet = ObjDocumentType.GetFormType(userInfo.userCompanyEntity)
        If (Not (StatusTypeSet Is Nothing) AndAlso StatusTypeSet.Tables.Count > 0 AndAlso Not (StatusTypeSet.Tables(0) Is Nothing) AndAlso StatusTypeSet.Tables(0).Rows.Count > 0) Then
            ddlFormType.DataSource = StatusTypeSet.Tables(0)
            ddlFormType.DataTextField = "menu_code"
            ddlFormType.DataValueField = "menu_code"
            ddlFormType.DataBind()
            ddlFormType.Items.Insert(0, New ListItem(Constant.Common.All, "All", True))
        End If
    End Sub
#End Region

